.HomeLayout .banner {
  width: 760rpx;
  padding: 30rpx 0;
}
.HomeLayout .banner swiper {
  width: 760rpx;
  height: 320rpx;
}
.HomeLayout .banner swiper-item {
  width: 100%;
  height: 100%;
  padding: 0 30rpx;
}
.HomeLayout .banner swiper-item image {
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
}
.HomeLayout .port {
  width: 690rpx;
  height: 70rpx;
  line-height: 70rpx;
  background-color: #f1f1f1;
  margin: 0 auto;
  border-radius: 80rpx;
  display: flex;
}
.HomeLayout .port .left {
  color: #b3e0f2;
  width: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.HomeLayout .port .left .text {
  font-size: 28rpx;
  font-weight: 600;
}
.HomeLayout .port .center {
  flex: 1;
}
.HomeLayout .port .center swiper {
  height: 100%;
}
.HomeLayout .port .center swiper-item {
  height: 100%;
  font-size: 30rpx;
  color: #666;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.HomeLayout .port .right {
  width: 70rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.HomeLayout .port .right .iconfont {
  font-size: 30rpx;
}
.selector {
  padding-top: 50rpx;
}
.selector .data {
  font-size: 24rpx;
  color: #b3e0f2;
  align-items: center;
}
.selector .content {
  width: 100%;
  margin-top: 30rpx;
}
.selector .content .scroll-container {
  white-space: nowrap;
  padding: 0 30rpx;
}
.selector .content .scroll-container .box {
  width: 220rpx;
  height: 380rpx;
  display: inline-block;
  margin-right: 20rpx;
}
.selector .content .scroll-container .box image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}
.theme {
  margin-top: 50rpx;
}
.theme .more {
  font-size: 32rpx;
  color: #666;
}
.theme .content {
  margin-top: 30rpx;
  padding: 0 30rpx;
  display: grid;
  gap: 15rpx;
  grid-template-columns: repeat(3, 1fr);
}